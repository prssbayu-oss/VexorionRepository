{
  "name": "vexorion",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "serve": "npx serve",
    "test": "node tests/run-all.js",
    "test:unit": "node tests/run-all.js",
    "test:e2e": "node tests/Puppeteer.e2e.js",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:one": "node",
    "test:headed": "cross-env HEADLESS=false node tests/Puppeteer.e2e.js",
    "test:watch": "node --watch tests/run-all.js"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "puppeteer": "^23.0.0",
    "vite": "^6.2.3"
  }
